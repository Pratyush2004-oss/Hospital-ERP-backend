# Copy to .env for local development: cp .env.example .env

# development | test | production
NODE_ENV=development

# HTTP port the API listens on
PORT=4000

# Base path for all versioned API routes
API_PREFIX=/api/v1

# Allowed browser origin for CORS (the web client)
FRONTEND_URL=http://localhost:3000
# Comma-separated additional browser origins, including Vercel preview domains
# and the final custom domain. Do not include paths.
CORS_ALLOWED_ORIGINS=

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=debug

# --- PostgreSQL (matches docker-compose.yml defaults) ---
# Administrative/owning connection: migrations, seeds, bootstrap, role provisioning.
DATABASE_URL=postgresql://hospitalos:hospitalos@localhost:5432/hospitalos
# Restricted runtime role used by the API. Must point at the same database as
# DATABASE_URL with different credentials, and must NOT be superuser/BYPASSRLS.
# Provision it once with: npm run db:provision-app-role
APP_DATABASE_URL=postgresql://hospitalos_app:hospitalos_app@localhost:5432/hospitalos
# Isolated database used by `npm test` (must end in _test). This is the admin URL.
TEST_DATABASE_URL=postgresql://hospitalos:hospitalos@localhost:5432/hospitalos_test
# Optional test overrides. When unset, the app URL is derived from
# TEST_DATABASE_URL with TEST_APP_DATABASE_USER/PASSWORD.
TEST_ADMIN_DATABASE_URL=
TEST_APP_DATABASE_URL=
TEST_APP_DATABASE_USER=hospitalos_app
TEST_APP_DATABASE_PASSWORD=hospitalos_app
# Maximum clients in the pool
DB_POOL_MAX=10
# Close idle clients after this many milliseconds
DB_IDLE_TIMEOUT=30000
# Fail a connection attempt after this many milliseconds
DB_CONNECTION_TIMEOUT=5000
# Set true for hosted PostgreSQL providers that require TLS verification.
# Use a valid CA automatically where supported; self-signed providers may need
# a provider-specific PG SSL configuration instead of disabling verification.
DB_SSL=false

# Comma-separated CORS origins are configured with CORS_ALLOWED_ORIGINS.

# --- HTTP hardening ---
# Window in milliseconds and per-window request budget for the general limiter.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300

# --- Authentication ---
# 32+ character random secret used to sign short-lived access JWTs.
# Generate with: node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
AUTH_ACCESS_TOKEN_SECRET=replace-with-a-64-character-random-hex-string
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_DAYS=30
AUTH_PASSWORD_RESET_TTL_MINUTES=30
AUTH_LOGIN_RATE_LIMIT_WINDOW_MS=900000
AUTH_LOGIN_RATE_LIMIT_MAX=10

# --- Transactional authentication email (ONB-03) ---
# none | mock | real. `none` suppresses verification/reset/invitation email;
# `mock` records messages in memory for development and tests; `real` sends via
# Resend. Production MUST be `real` with an API key; the API refuses to start
# otherwise, so mock delivery can never silently ship.
AUTH_MAIL_PROVIDER=none
# Sender identity. With `real`, this domain must be verified in the provider.
AUTH_MAIL_FROM_EMAIL=no-reply@hospitalos.invalid
AUTH_MAIL_FROM_NAME=HospitalOS
# Optional Reply-To/support address shown in authentication emails.
AUTH_MAIL_REPLY_TO=
# Real provider credential. Never commit a real key. Create one at
# https://resend.com/api-keys and verify the sender domain first.
AUTH_MAIL_RESEND_API_KEY=
AUTH_MAIL_API_BASE_URL=https://api.resend.com
AUTH_MAIL_TIMEOUT_MS=5000
# Email verification link lifetime (5 minutes - 7 days).
AUTH_EMAIL_VERIFICATION_TTL_MINUTES=1440
# Staff invitation link lifetime (1 - 720 hours).
AUTH_INVITATION_TTL_HOURS=168
# Minimum seconds between repeated verification/invitation emails.
# 0 disables the cooldown (tests use 0).
AUTH_EMAIL_RESEND_COOLDOWN_SECONDS=60
# Optional: `npm run db:bootstrap` grants platform_super_admin to this existing
# account. Leave empty when platform access is provisioned manually.
PLATFORM_SUPER_ADMIN_EMAIL=

# --- Development seed (npm run db:seed) ---
# Optional override for the password of seeded development accounts.
# Leave empty to use the documented placeholder in src/database/seed/helpers.ts.
# Never put a real password here.
SEED_ADMIN_PASSWORD=

# --- Private document storage ---
# Only `local` ships today. An S3-compatible adapter can be added later behind
# the same StorageProvider interface once its credentials are configured.
STORAGE_DRIVER=local
# Directory relative to apps/api (the process working directory). Must be a
# private location; a public/static directory name is rejected at startup.
# The API never serves this directory statically.
STORAGE_LOCAL_ROOT=storage/private
# Hard ceiling for one uploaded document, in bytes (default 10 MiB).
STORAGE_MAX_FILE_SIZE_BYTES=10485760
# Signed download URL lifetime in seconds (30-3600).
STORAGE_SIGNED_URL_TTL_SECONDS=300
# Optional 32+ character secret used to sign local download URLs. When unset, a
# storage-specific key is derived from AUTH_ACCESS_TOKEN_SECRET. Set it in
# production so rotating auth tokens does not invalidate outstanding links.
STORAGE_SIGNING_SECRET=

# --- Payment gateway ---
# Registry key of the provider adapter. `mock` is the offline dev/test adapter
# and needs no credentials or network access.
PAYMENT_GATEWAY_PROVIDER=mock
# Deadline for one provider order-creation call, in milliseconds.
PAYMENT_GATEWAY_TIMEOUT_MS=5000
# Base URL for the mock adapter's hosted checkout page.
PAYMENT_GATEWAY_CHECKOUT_BASE_URL=https://sandbox.payments.invalid/checkout
# Optional provider API key; unused by `mock` and never exposed to clients.
PAYMENT_GATEWAY_API_KEY=

# --- Central notifications (Phase 20) ---
# `none` leaves a channel unconfigured (deliveries become SKIPPED). `mock`
# produces deterministic provider ids without contacting any external service.
# Real adapters must be added behind the NotificationProvider interface.
NOTIFICATION_EMAIL_PROVIDER=none
NOTIFICATION_SMS_PROVIDER=none
NOTIFICATION_WHATSAPP_PROVIDER=none
NOTIFICATION_RETRY_BASE_SECONDS=900
NOTIFICATION_BATCH_SIZE=50
# Lease for a claimed delivery; expired PROCESSING rows are reclaimed after a
# worker crash (30-3600 seconds).
NOTIFICATION_PROCESSING_TIMEOUT_SECONDS=300
NOTIFICATION_WORKER_ENABLED=true
NOTIFICATION_WORKER_INTERVAL_MS=15000

# --- Appointment reminders ---
# Comma-separated minutes before the appointment start. Tenants may override
# these and the enabled channels in tenant_settings under
# `appointment.notifications`.
APPOINTMENT_REMINDER_MINUTES=1440,60
APPOINTMENT_REMINDER_SCHEDULER_ENABLED=true
APPOINTMENT_REMINDER_INTERVAL_MS=60000

# --- Redis (matches docker-compose.yml defaults) ---
REDIS_URL=redis://localhost:6379
# Fail a connection attempt after this many milliseconds
REDIS_CONNECT_TIMEOUT=5000
# Retries per command before it is rejected while Redis is unreachable
REDIS_MAX_RETRIES=3

# --- Billing notifications (Phase 19.10) ---
# The billing outbox remains the delivery path for billing EMAIL/SMS. Central
# in-app items are added by the Phase 20 bridge; no billing tables are replaced.
BILLING_NOTIFICATION_EMAIL_PROVIDER=none
BILLING_NOTIFICATION_SMS_PROVIDER=none
BILLING_NOTIFICATION_FROM_EMAIL=no-reply@hospitalos.invalid
BILLING_NOTIFICATION_FROM_SMS=HOSPITAL
BILLING_NOTIFICATION_RETRY_BASE_SECONDS=900
BILLING_NOTIFICATION_PROCESSING_TIMEOUT_SECONDS=300
BILLING_NOTIFICATION_BATCH_SIZE=50
BILLING_REMINDER_SCHEDULER_ENABLED=true
BILLING_REMINDER_SCHEDULER_INTERVAL_MS=60000

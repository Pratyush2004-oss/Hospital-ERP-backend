{
  "name": "@hospitalos/api",
  "version": "0.1.0",
  "private": true,
  "description": "HospitalOS multi-tenant hospital ERP API",
  "type": "module",
  "main": "dist/server.js",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/server.ts",
    "build": "tsc -p tsconfig.json",
    "vercel-build": "npm run build",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "pretest": "tsx src/test/setup-database.ts",
    "pretest:vitest": "tsx src/test/setup-database.ts",
    "test": "npm run test:node && npm run test:vitest",
    "test:node": "node --test-concurrency=1 --import tsx --import ./src/test/setup-env.ts --test src/modules/auth/auth.test.ts src/modules/tenancy/tenancy.test.ts",
    "test:vitest": "vitest run",
    "test:watch": "vitest",
    "db:bootstrap": "tsx src/database/bootstrap.ts",
    "db:provision-app-role": "tsx src/database/provision-app-role.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx src/database/seed/index.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "csv-stringify": "^6.9.0",
    "dotenv": "^18.0.9",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jose": "^6.2.15",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/pdfkit": "^0.17.5",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "drizzle-kit": "^0.31.11",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
